<div class="kartu">
    <div class="kartu-kepala">
        <div>
            <h2 class="kartu-judul"><i class="bi bi-person-plus"></i><c:out value="${judulForm}" /></h2>
            <p class="kartu-sub">Kolom bertanda <span class="wajib">*</span> wajib diisi.</p>
        </div>
        <a class="btn btn-light" href="${ctx}/pasien"><i class="bi bi-arrow-left"></i>Kembali</a>
    </div>

    <c:if test="${not empty pesanError}">
        <div class="panel-error"><i class="bi bi-exclamation-triangle me-2"></i><c:out value="${pesanError}" /></div>
    </c:if>
    <c:if test="${not empty errors}">
        <div class="panel-error">
            <strong>Perbaiki data berikut:</strong>
            <ul class="mt-1">
                <c:forEach items="${errors}" var="e">
                    <li><c:out value="${e.value}" /></li>
                </c:forEach>
            </ul>
        </div>
    </c:if>

    <form method="post" action="${ctx}/pasien" class="row g-3">
        <input type="hidden" name="aksi" value="${aksiForm}">
        <input type="hidden" name="id" value="${data.idPasien}">

        <div class="col-md-6">
            <label class="form-label" for="nik">NIK <span class="wajib">*</span></label>
            <input type="text" class="form-control ${not empty errors.nik ? 'is-invalid' : ''}" id="nik" name="nik"
                   value="<c:out value='${data.nik}'/>" maxlength="16" placeholder="16 digit angka" required>
            <div class="invalid-feedback"><c:out value="${errors.nik}" /></div>
        </div>
        <div class="col-md-6">
            <label class="form-label" for="namaPasien">Nama Lengkap <span class="wajib">*</span></label>
            <input type="text" class="form-control ${not empty errors.namaPasien ? 'is-invalid' : ''}" id="namaPasien" name="namaPasien"
                   value="<c:out value='${data.namaPasien}'/>" placeholder="Nama lengkap sesuai identitas" required>
            <div class="invalid-feedback"><c:out value="${errors.namaPasien}" /></div>
        </div>

        <div class="col-md-4">
            <label class="form-label" for="jenisKelamin">Jenis Kelamin <span class="wajib">*</span></label>
            <select class="form-select ${not empty errors.jenisKelamin ? 'is-invalid' : ''}" id="jenisKelamin" name="jenisKelamin" required>
                <option value="">Pilih jenis kelamin</option>
                <option value="Laki-laki" <c:if test="${data.jenisKelamin eq 'Laki-laki'}">selected</c:if>>Laki-laki</option>
                <option value="Perempuan" <c:if test="${data.jenisKelamin eq 'Perempuan'}">selected</c:if>>Perempuan</option>
            </select>
            <div class="invalid-feedback"><c:out value="${errors.jenisKelamin}" /></div>
        </div>
        <div class="col-md-4">
            <label class="form-label" for="tempatLahir">Tempat Lahir <span class="wajib">*</span></label>
            <input type="text" class="form-control ${not empty errors.tempatLahir ? 'is-invalid' : ''}" id="tempatLahir" name="tempatLahir"
                   value="<c:out value='${data.tempatLahir}'/>" placeholder="Contoh: Yogyakarta" required>
            <div class="invalid-feedback"><c:out value="${errors.tempatLahir}" /></div>
        </div>
        <div class="col-md-4">
            <label class="form-label" for="tanggalLahir">Tanggal Lahir <span class="wajib">*</span></label>
            <input type="date" class="form-control ${not empty errors.tanggalLahir ? 'is-invalid' : ''}" id="tanggalLahir" name="tanggalLahir"
                   value="<c:out value='${data.tanggalLahir}'/>" required>
            <div class="invalid-feedback"><c:out value="${errors.tanggalLahir}" /></div>
        </div>

        <div class="col-md-4">
            <label class="form-label" for="golonganDarah">Golongan Darah</label>
            <select class="form-select" id="golonganDarah" name="golonganDarah">
                <option value="">Belum diketahui</option>
                <c:forEach items="${['A','B','AB','O']}" var="gol">
                    <option value="${gol}" <c:if test="${data.golonganDarah eq gol}">selected</c:if>>${gol}</option>
                </c:forEach>
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label" for="noTelepon">No. Telepon <span class="wajib">*</span></label>
            <input type="text" class="form-control ${not empty errors.noTelepon ? 'is-invalid' : ''}" id="noTelepon" name="noTelepon"
                   value="<c:out value='${data.noTelepon}'/>" placeholder="Contoh: 081234567890" required>
            <div class="invalid-feedback"><c:out value="${errors.noTelepon}" /></div>
        </div>
        <div class="col-md-4">
            <label class="form-label" for="statusPasien">Status Pasien <span class="wajib">*</span></label>
            <select class="form-select ${not empty errors.statusPasien ? 'is-invalid' : ''}" id="statusPasien" name="statusPasien" required>
                <option value="">Pilih status</option>
                <option value="RAWAT JALAN" <c:if test="${data.statusPasien eq 'RAWAT JALAN'}">selected</c:if>>Rawat Jalan</option>
                <option value="DIRAWAT" <c:if test="${data.statusPasien eq 'DIRAWAT'}">selected</c:if>>Dirawat</option>
                <option value="PULANG" <c:if test="${data.statusPasien eq 'PULANG'}">selected</c:if>>Pulang</option>
            </select>
            <div class="invalid-feedback"><c:out value="${errors.statusPasien}" /></div>
        </div>

        <div class="col-12">
            <label class="form-label" for="alamat">Alamat <span class="wajib">*</span></label>
            <textarea class="form-control ${not empty errors.alamat ? 'is-invalid' : ''}" id="alamat" name="alamat" rows="2"
                      placeholder="Alamat lengkap domisili"><c:out value='${data.alamat}'/></textarea>
            <div class="invalid-feedback"><c:out value="${errors.alamat}" /></div>
        </div>

        <div class="col-md-6">
            <label class="form-label" for="idPenyakit">Penyakit</label>
            <select class="form-select ${not empty errors.idPenyakit ? 'is-invalid' : ''}" id="idPenyakit" name="idPenyakit">
                <option value="">Belum ada penyakit terdiagnosis</option>
                <c:forEach items="${daftarPenyakit}" var="py">
                    <option value="${py.idPenyakit}" <c:if test="${data.idPenyakit eq py.idPenyakit}">selected</c:if>>${py.namaPenyakit} (${py.kodePenyakit})</option>
                </c:forEach>
            </select>
            <div class="invalid-feedback"><c:out value="${errors.idPenyakit}" /></div>
        </div>
        <div class="col-md-6">
            <label class="form-label" for="idDokter">Dokter Penanggung Jawab</label>
            <select class="form-select ${not empty errors.idDokter ? 'is-invalid' : ''}" id="idDokter" name="idDokter">
                <option value="">Belum ditentukan</option>
                <c:forEach items="${daftarDokter}" var="d">
                    <option value="${d.idDokter}" <c:if test="${data.idDokter eq d.idDokter}">selected</c:if>>dr. ${d.namaDokter} - ${d.spesialisasi}</option>
                </c:forEach>
            </select>
            <div class="invalid-feedback"><c:out value="${errors.idDokter}" /></div>
        </div>

        <div class="col-md-4">
            <label class="form-label" for="tanggalMasuk">Tanggal Masuk <span class="wajib">*</span></label>
            <input type="date" class="form-control ${not empty errors.tanggalMasuk ? 'is-invalid' : ''}" id="tanggalMasuk" name="tanggalMasuk"
                   value="<c:out value='${empty data.tanggalMasuk ? tanggalHariIni : data.tanggalMasuk}'/>" required>
            <div class="invalid-feedback"><c:out value="${errors.tanggalMasuk}" /></div>
        </div>
        <div class="col-md-4">
            <label class="form-label" for="tanggalKeluar">Tanggal Keluar</label>
            <input type="date" class="form-control ${not empty errors.tanggalKeluar ? 'is-invalid' : ''}" id="tanggalKeluar" name="tanggalKeluar"
                   value="<c:out value='${data.tanggalKeluar}'/>">
            <div class="invalid-feedback"><c:out value="${errors.tanggalKeluar}" /></div>
            <div class="form-text">Kosongkan jika pasien masih berada di rumah sakit.</div>
        </div>
        <div class="col-md-4">
            <label class="form-label" for="idPengguna">Akun Login Pasien</label>
            <select class="form-select ${not empty errors.idPengguna ? 'is-invalid' : ''}" id="idPengguna" name="idPengguna">
                <option value="">Belum memiliki akun</option>
                <c:forEach items="${daftarAkunPasien}" var="ak">
                    <option value="${ak.idPengguna}" <c:if test="${data.idPengguna eq ak.idPengguna}">selected</c:if>>${ak.username} - ${ak.namaLengkap}</option>
                </c:forEach>
            </select>
            <div class="invalid-feedback"><c:out value="${errors.idPengguna}" /></div>
        </div>

        <c:if test="${aksiForm eq 'simpan'}">
            <div class="col-12">
                <div class="panel-error mb-0" style="background:#FBF3EC;border-color:#E8D8C8;color:#7A1C1C;">
                    <i class="bi bi-info-circle me-2"></i>
                    Isi <strong>username</strong> dan <strong>password</strong> di bawah hanya jika pasien baru juga memerlukan akun untuk login ke portal.
                </div>
            </div>
            <div class="col-md-6">
                <label class="form-label" for="usernameAkun">Username Akun Baru</label>
                <input type="text" class="form-control ${not empty errors.usernameAkun ? 'is-invalid' : ''}" id="usernameAkun" name="usernameAkun"
                       placeholder="Contoh: pasien05" autocomplete="off">
                <div class="invalid-feedback"><c:out value="${errors.usernameAkun}" /></div>
            </div>
            <div class="col-md-6">
                <label class="form-label" for="passwordAkun">Password Akun Baru</label>
                <input type="password" class="form-control ${not empty errors.passwordAkun ? 'is-invalid' : ''}" id="passwordAkun" name="passwordAkun"
                       placeholder="Minimal 6 karakter" autocomplete="new-password">
                <div class="invalid-feedback"><c:out value="${errors.passwordAkun}" /></div>
            </div>
        </c:if>

        <div class="col-12 d-flex gap-2">
            <button class="btn btn-primary" type="submit"><i class="bi bi-check2-circle"></i>${aksiForm eq 'simpan' ? 'Simpan Pasien' : 'Perbarui Data'}</button>
            <a class="btn btn-light" href="${ctx}/pasien">Batal</a>
        </div>
    </form>
</div>
